---
---

<section class="section pricing-section">
  <div class="container">
    <div class="section-header">
      <h2>Investment in Legacy</h2>
      <p>
        One-time cost to preserve a lifetime of memories—no subscriptions, no hidden fees
      </p>
    </div>

    <div class="pricing-grid">
      <!-- Basic Tier -->
      <div class="pricing-card">
        <div class="pricing-header">
          <h3>Essential</h3>
          <div class="pricing">
            <span class="currency">$</span>
            <span class="amount">497</span>
          </div>
          <p class="pricing-period">One-time payment</p>
        </div>

        <div class="pricing-features">
          <h4>What's Included:</h4>
          <ul>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>10 AI conversations</strong>
                <span>30-minute calls in your native language</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Audio recordings</strong>
                <span>Download or stream via Google Drive</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Written transcript</strong>
                <span>Full text in original language + English translation</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Basic Google Sites</strong>
                <span>Simple shareable page with chapters</span>
              </div>
            </li>
            <li class="not-included">
              <span class="cross">✗</span>
              <span>Photo gallery integration</span>
            </li>
            <li class="not-included">
              <span class="cross">✗</span>
              <span>Family interview add-ons</span>
            </li>
          </ul>
        </div>

        <a href="#contact" class="btn-pricing">Get Started</a>
      </div>

      <!-- Popular Tier -->
      <div class="pricing-card featured">
        <div class="popular-badge">Most Popular</div>
        <div class="pricing-header">
          <h3>Premium</h3>
          <div class="pricing">
            <span class="currency">$</span>
            <span class="amount">897</span>
          </div>
          <p class="pricing-period">One-time payment</p>
        </div>

        <div class="pricing-features">
          <h4>Everything in Essential, plus:</h4>
          <ul>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>10 AI conversations</strong>
                <span>30-minute calls in your native language</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Audio recordings</strong>
                <span>High-quality, organized by chapter</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Bilingual transcript</strong>
                <span>Side-by-side native language + English</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Custom Google Sites</strong>
                <span>Beautiful design with your photos</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Photo integration</strong>
                <span>Up to 50 photos scanned & added</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Family access</strong>
                <span>Add up to 3 family members to contribute questions</span>
              </div>
            </li>
          </ul>
        </div>

        <a href="#contact" class="btn-pricing primary">Get Started</a>
      </div>

      <!-- Legacy Tier -->
      <div class="pricing-card">
        <div class="pricing-header">
          <h3>Legacy</h3>
          <div class="pricing">
            <span class="currency">$</span>
            <span class="amount">1,497</span>
          </div>
          <p class="pricing-period">One-time payment</p>
        </div>

        <div class="pricing-features">
          <h4>Everything in Premium, plus:</h4>
          <ul>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Extended conversations</strong>
                <span>45-minute calls for deeper storytelling</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Video interview option</strong>
                <span>Add video recording of conversations</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Unlimited photos</strong>
                <span>We scan and organize your entire collection</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Hardcover book</strong>
                <span>Printed memoir delivered to your door</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Family interviews</strong>
                <span>Include spouse, children, siblings</span>
              </div>
            </li>
            <li>
              <span class="check">✓</span>
              <div>
                <strong>Priority support</strong>
                <span>Dedicated project manager</span>
              </div>
            </li>
          </ul>
        </div>

        <a href="#contact" class="btn-pricing">Get Started</a>
      </div>
    </div>

    <div class="pricing-guarantee">
      <div class="guarantee-icon">🛡️</div>
      <div class="guarantee-text">
        <h4>Satisfaction Guarantee</h4>
        <p>
          Not happy after the first conversation? Full refund, no questions asked.
          Your story matters, and we want you to feel comfortable sharing it.
        </p>
      </div>
    </div>

    <div class="pricing-notes">
      <h4>Flexible Payment Options</h4>
      <ul>
        <li><strong>Payment plans available</strong> — Split into 3 monthly payments (no interest)</li>
        <li><strong>Gift vouchers</strong> — Children can purchase for parents as a meaningful gift</li>
        <li><strong>Group discounts</strong> — Multiple family members? Contact us for special pricing</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: var(--color-paper);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .pricing-card {
    background: var(--color-paper);
    border: 2px solid var(--color-sepia-light);
    border-radius: 0.75rem;
    padding: 2rem;
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .pricing-card:hover {
    border-color: var(--color-ocean-700);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(12, 35, 64, 0.15);
  }

  .pricing-card.featured {
    border-color: var(--color-ocean-900);
    border-width: 3px;
    background: linear-gradient(180deg, var(--color-sunrise-light) 0%, var(--color-paper) 100%);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-ocean-900);
    color: var(--color-sunrise);
    padding: 0.5rem 1.5rem;
    border-radius: 2rem;
    font-weight: 600;
    font-size: 0.8125rem;
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--color-sepia-light);
  }

  .pricing-header h3 {
    color: var(--color-ocean-900);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .pricing {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .currency {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ocean-900);
    margin-top: 0.25rem;
  }

  .amount {
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--color-ocean-900);
    line-height: 1;
  }

  .pricing-period {
    color: var(--color-sepia);
    font-size: 0.875rem;
  }

  .pricing-features h4 {
    color: var(--color-ocean-900);
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .pricing-features ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex: 1;
  }

  .pricing-features li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .pricing-features .check {
    color: var(--color-ocean-700);
    font-size: 1.25rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .pricing-features .cross {
    color: var(--color-sepia-light);
    font-size: 1.25rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .pricing-features div {
    display: flex;
    flex-direction: column;
  }

  .pricing-features strong {
    color: var(--color-ocean-900);
    font-size: 0.9375rem;
    margin-bottom: 0.125rem;
  }

  .pricing-features span {
    color: var(--color-sepia);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .not-included {
    opacity: 0.6;
  }

  .btn-pricing {
    display: inline-block;
    width: 100%;
    padding: 1rem 2rem;
    background: var(--color-ocean-900);
    color: var(--color-paper);
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 600;
    text-align: center;
    transition: all 0.3s ease;
    border: 2px solid var(--color-ocean-900);
  }

  .btn-pricing:hover {
    background: transparent;
    color: var(--color-ocean-900);
  }

  .btn-pricing.primary {
    background: var(--color-ocean-900);
  }

  .pricing-guarantee {
    background: linear-gradient(135deg, var(--color-sunrise-light) 0%, var(--color-paper) 100%);
    border: 2px solid var(--color-ocean-900);
    border-radius: 0.75rem;
    padding: 2rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 3rem;
  }

  .guarantee-icon {
    font-size: 3rem;
  }

  .guarantee-text h4 {
    color: var(--color-ocean-900);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .guarantee-text p {
    color: var(--color-sepia);
    line-height: 1.6;
  }

  .pricing-notes {
    background: var(--color-paper-dark);
    border-radius: 0.5rem;
    padding: 2rem;
  }

  .pricing-notes h4 {
    color: var(--color-ocean-900);
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .pricing-notes ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pricing-notes li {
    color: var(--color-sepia);
    line-height: 1.6;
  }

  .pricing-notes strong {
    color: var(--color-ocean-900);
  }

  @media (max-width: 1024px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .pricing-card {
      max-width: 500px;
      margin: 0 auto;
    }
  }

  @media (max-width: 768px) {
    .pricing-guarantee {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .guarantee-icon {
      display: block;
      margin: 0 auto;
    }
  }
</style>
