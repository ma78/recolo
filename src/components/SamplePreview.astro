---
---

<section class="section preview-section">
  <div class="container">
    <div class="section-header">
      <h2>What You'll Receive</h2>
      <p>
        A beautiful, shareable digital memoir that preserves your voice forever
      </p>
    </div>

    <div class="preview-container">
      <div class="preview-frame">
        <div class="browser-chrome">
          <div class="browser-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <div class="browser-url">
            <span>sites.google.com/view/giovanni-rossi-memoir</span>
          </div>
        </div>

        <div class="preview-content">
          <div class="memoir-header">
            <span class="memoir-flag">🇮🇹</span>
            <h3>Giovanni Rossi</h3>
            <p class="memoir-subtitle">From Naples to Newcastle: A Post-War Italian Journey</p>
            <p class="memoir-dates">1952 - 2025</p>
          </div>

          <div class="memoir-chapters">
            <div class="chapter-preview active">
              <div class="chapter-number">01</div>
              <div class="chapter-info">
                <h4>Leaving Naples</h4>
                <p>The day I said goodbye to my mother, the wheat fields, and the only home I'd ever known.</p>
                <div class="chapter-media">
                  <span class="media-icon">🎙️</span>
                  <span class="media-label">Audio: 28 min</span>
                </div>
              </div>
            </div>

            <div class="chapter-preview">
              <div class="chapter-number">02</div>
              <div class="chapter-info">
                <h4>Thirty Days at Sea</h4>
                <p>The ship was crowded, the food was strange, and I met Maria in the dining hall.</p>
                <div class="chapter-media">
                  <span class="media-icon">🎙️</span>
                  <span class="media-label">Audio: 32 min</span>
                </div>
              </div>
            </div>

            <div class="chapter-preview">
              <div class="chapter-number">03</div>
              <div class="chapter-info">
                <h4>First Sight of Australia</h4>
                <p>The heat hit us first. Then the realization: there was work for everyone who wanted it.</p>
                <div class="chapter-media">
                  <span class="media-icon">🎙️</span>
                  <span class="media-label">Audio: 29 min</span>
                </div>
              </div>
            </div>

            <div class="chapter-preview">
              <div class="chapter-number">10</div>
              <div class="chapter-info">
                <h4>What I Leave Behind</h4>
                <p>My children speak English, but they understand Italian. This story is for them.</p>
                <div class="chapter-media">
                  <span class="media-icon">🎙️</span>
                  <span class="media-label">Audio: 35 min</span>
                </div>
              </div>
            </div>
          </div>

          <div class="memoir-photos">
            <div class="photo-placeholder">
              <span class="photo-icon">📷</span>
              <span>Wedding photo, 1958</span>
            </div>
            <div class="photo-placeholder">
              <span class="photo-icon">📷</span>
              <span>First home, 1962</span>
            </div>
            <div class="photo-placeholder">
              <span class="photo-icon">📷</span>
              <span>Family reunion, 1975</span>
            </div>
          </div>
        </div>
      </div>

      <div class="preview-features">
        <div class="feature-item">
          <span class="feature-icon">🔗</span>
          <h4>Shareable Link</h4>
          <p>Send your Google Sites link to children, grandchildren, and relatives worldwide</p>
        </div>
        <div class="feature-item">
          <span class="feature-icon">🎧</span>
          <h4>Audio Recordings</h4>
          <p>Every conversation preserved in your voice, with your expressions and pauses</p>
        </div>
        <div class="feature-item">
          <span class="feature-icon">📸</span>
          <h4>Photo Gallery</h4>
          <p>Upload vintage photos to illustrate each chapter of your journey</p>
        </div>
        <div class="feature-item">
          <span class="feature-icon">📝</span>
          <h4>Written Transcript</h4>
          <p>Full text version for reading, searching, and printing</p>
        </div>
        <div class="feature-item">
          <span class="feature-icon">🌍</span>
          <h4>Multi-Language</h4>
          <p>Stories told in your language, accessible to future generations</p>
        </div>
        <div class="feature-item">
          <span class="feature-icon">♾️</span>
          <h4>Permanent Home</h4>
          <p>Google Sites doesn't expire—your story lives forever</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .preview-section {
    background: linear-gradient(180deg, var(--color-paper-dark) 0%, var(--color-paper) 100%);
  }

  .preview-container {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .preview-frame {
    background: var(--color-ocean-900);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(12, 35, 64, 0.25);
  }

  .browser-chrome {
    background: var(--color-ocean-800);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--color-ocean-700);
  }

  .browser-dots {
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green { background: #28c840; }

  .browser-url {
    flex: 1;
    background: var(--color-ocean-900);
    padding: 0.375rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-paper-dark);
    font-family: monospace;
  }

  .preview-content {
    background: var(--color-paper);
    padding: 2rem;
    min-height: 600px;
  }

  .memoir-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--color-sepia-light);
  }

  .memoir-flag {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
  }

  .memoir-header h3 {
    color: var(--color-ocean-900);
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .memoir-subtitle {
    color: var(--color-sepia);
    font-style: italic;
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .memoir-dates {
    color: var(--color-ocean-700);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .memoir-chapters {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .chapter-preview {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1rem;
    border: 2px solid var(--color-sepia-light);
    border-radius: 0.5rem;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .chapter-preview:hover,
  .chapter-preview.active {
    border-color: var(--color-ocean-700);
    background: var(--color-sunrise-light);
  }

  .chapter-number {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-ocean-900);
    color: var(--color-sunrise);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
  }

  .chapter-info h4 {
    color: var(--color-ocean-900);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .chapter-info p {
    color: var(--color-sepia);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .chapter-media {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .media-icon {
    font-size: 1rem;
  }

  .media-label {
    font-size: 0.8125rem;
    color: var(--color-ocean-700);
    font-weight: 600;
  }

  .memoir-photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .photo-placeholder {
    background: var(--color-paper-dark);
    border: 2px solid var(--color-sepia-light);
    border-radius: 0.5rem;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    text-align: center;
  }

  .photo-icon {
    font-size: 2rem;
  }

  .photo-placeholder span:last-child {
    font-size: 0.75rem;
    color: var(--color-sepia);
    font-weight: 500;
  }

  .preview-features {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .feature-item {
    background: var(--color-paper);
    padding: 1.5rem;
    border-radius: 0.5rem;
    border-left: 4px solid var(--color-ocean-900);
  }

  .feature-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .feature-item h4 {
    color: var(--color-ocean-900);
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .feature-item p {
    color: var(--color-sepia);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .preview-container {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .memoir-photos {
      grid-template-columns: 1fr;
    }

    .chapter-preview {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .chapter-number {
      margin: 0 auto;
    }
  }
</style>
